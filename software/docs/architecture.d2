# ============================================================================
# Squid Microscope Control Software — Architecture Diagram
# Entry point: python software/main_hcs.py
# ============================================================================

direction: right
layout: tala

# ============================================================================
# STYLES
# ============================================================================
classes: {
  hw: {
    style: {
      fill: "#fce4ec"
      stroke: "#c62828"
      border-radius: 8
      font-color: "#b71c1c"
    }
  }
  controller: {
    style: {
      fill: "#e3f2fd"
      stroke: "#1565c0"
      border-radius: 8
    }
  }
  model: {
    style: {
      fill: "#fff9c4"
      stroke: "#f9a825"
      border-radius: 4
    }
  }
  gui: {
    style: {
      fill: "#e8f5e9"
      stroke: "#2e7d32"
      border-radius: 8
    }
  }
  io: {
    style: {
      fill: "#f3e5f5"
      stroke: "#7b1fa2"
      border-radius: 8
    }
  }
  storage: {
    style: {
      fill: "#efebe9"
      stroke: "#4e342e"
      border-radius: 4
      3d: true
    }
  }
  signal_style: {
    style: {
      stroke: "#ff6f00"
      stroke-dash: 4
    }
  }
}

# ============================================================================
# ENTRY POINT
# ============================================================================
main_hcs: "main_hcs.py\n(Entry Point)" {
  class: controller
  tooltip: "Parses CLI args, creates QApplication,\nbuilds Microscope, launches GUI"
}

# ============================================================================
# GUI LAYER
# ============================================================================
gui: "GUI Layer (PyQt5)" {
  style.fill: "#e8f5e9"
  style.stroke: "#2e7d32"

  main_window: "HighContentScreeningGui\n(QMainWindow)" {
    class: gui
    tooltip: "Main application window.\nHolds references to all controllers and widgets."
  }

  # --- Widget groups ---
  live_widgets: "Live Imaging Widgets" {
    class: gui
    camera_settings: "CameraSettingsWidget\nexposure, gain, binning,\nROI, trigger mode"
    live_control: "LiveControlWidget\nstart/stop live, FPS"
    recording: "RecordingWidget\nsnap / record"
    illumination: "IlluminationWidget\nper-channel intensity\nsliders + on/off"
    obs_state: "ObservationStateWidget\nsave/load presets"
  }

  hardware_widgets: "Hardware Control Widgets" {
    class: gui
    navigation: "NavigationWidget\nstage XYZ jogging"
    objectives: "ObjectivesWidget\nobjective selector"
    profile: "ProfileWidget\nruntime user-profile switcher\n(opens from Settings menu)"
    profile_startup: "ProfileSelectionDialog\npre-startup profile picker"
    piezo: "PiezoWidget\nfine Z control"
    emission_fw: "EmissionFilterWheelPanel"
    confocal: "SpinningDiskConfocalWidget\ndisk speed, dichroic, filters"
    laser_af: "LaserAutofocusSettingWidget\nexposure, gain, calibration + live view\n(Tools menu popup: 'Focus Camera / Laser AF Setup')"
    laser_af_ctrl_widget: "LaserAutofocusControlWidget\nInitialize + status indicator (green only after a\nsuccessful Initialize this session; amber when ROI\nloaded from cache), Set Reference, Measure Displacement\n('Laser AF' tab)"
    autofocus: "AutoFocusWidget\nN planes, delta Z"
  }

  acquisition_widgets: "Acquisition Widgets" {
    class: gui
    flex_mp: "FlexibleMultiPointWidget\ngrid scan: ΔX, NX, ΔY, NY"
    wellplate_mp: "WellplateMultiPointWidget\nwell selection, per-well FOV grid"
    template_mp: "TemplateMultiPointWidget\ntemplate-based scan"
    focus_map: "FocusMapWidget\n3-point calibration,\ninterpolation fitting"
  }

  viewers: "Visualization" {
    class: gui
    napari: "Napari Viewer\nmulti-channel image display"
    plate_view: "Plate View\nHCS overview"
    nd_viewer: "NDViewer\nTIFF / Zarr browsing"
    stats: "StatsDisplayWidget"
  }

  main_window -> live_widgets
  main_window -> hardware_widgets
  main_window -> acquisition_widgets
  main_window -> viewers
}

# ============================================================================
# CORE CONTROLLERS
# ============================================================================
controllers: "Core Controllers" {
  style.fill: "#e3f2fd"
  style.stroke: "#1565c0"

  microscope: "Microscope\n(Root Aggregator)" {
    class: controller
    tooltip: |md
      Central object built from machine_config.yaml.
      Owns all hardware references, controllers, and addons.
    |
  }

  obs_ctrl: "ObservationStateController" {
    class: controller
    tooltip: |md
      Central authority for the current ObservationState.
      - Owns current_observation_state
      - Mediates all widget-to-hardware communication
      - Manages illumination, camera settings, optical path
      - Handles preset loading and state collection
    |
  }

  live_ctrl: "LiveController" {
    class: controller
    tooltip: |md
      Manages live camera streaming and triggering only.
      - Toggles trigger mode (SW / HW / continuous)
      - Controls frame rate via internal timer
      - Manages streaming gate for illumination synchronization
    |
  }

  mp_ctrl: "MultiPointController\n(QtMultiPointController)" {
    class: controller
    tooltip: |md
      Orchestrates multi-position acquisition:
      1. Generate grid coordinates
      2. Resolve selected cycles → per-region RegionPlan
         (flat ordered events + dense/ragged flag)
      3. Per FOV: move stage → autofocus → run the
         cycle (interleaved frames + stimulus) → save
      4. Repeat for Z-stack, time-lapse (Nt)
      A flat (no-cycle) selection resolves to a
      1-frame-per-state plan — the legacy path.
    |
  }

  af_ctrl: "AutoFocusController\n(QtAutoFocusController)" {
    class: controller
    tooltip: |md
      Software autofocus via defocus sweep.
      Scans N Z-planes, measures image sharpness,
      moves to best-focus position.
    |
  }

  laser_af_ctrl: "LaserAutofocusController" {
    class: controller
    tooltip: |md
      Hardware reflection-based autofocus.
      Monitors laser spot position shift on focus camera
      to infer Z displacement. Per-objective calibration.
      Reference (spot x + crop) is capture/apply/get-active
      so flexible multipoint can carry a distinct
      LaserAFReference per region (via ScanPositionInformation);
      regions without one fall back to the global reference.
    |
  }

  illum_ctrl: "IlluminationController" {
    class: controller
    tooltip: |md
      Coordinates all light sources.
      Channels: set_intensity, turn_on/off.
      Devices: CoolLED, Andor Laser, LED matrix, IO-routed lasers.
    |
  }

  stream_handler: "StreamHandler" {
    class: controller
    tooltip: |md
      Frame routing hub.
      Camera → on_new_frame() → display callback + save callback.
      Rate-limits display and save independently.
    |
  }

  obj_store: "ObjectiveStore" {
    class: controller
    tooltip: |md
      Tracks current objective, magnification,
      pixel size factor, tube lens focal length.
    |
  }

  contrast_mgr: "ContrastManager" {
    class: controller
    tooltip: "Per-channel brightness/contrast adjustment for display"
  }

  movement_updater: "MovementUpdater\n(QObject)" {
    class: controller
    tooltip: "Emits Qt signals with stage position after moves"
  }

  # Controller ownership
  microscope -> live_ctrl: owns
  microscope -> illum_ctrl: owns
  microscope -> stream_handler: owns
  microscope -> obj_store: owns
  microscope -> contrast_mgr: owns
}

# ============================================================================
# IO ABSTRACTION LAYER
# ============================================================================
io_layer: "IO Abstraction Layer" {
  style.fill: "#f3e5f5"
  style.stroke: "#7b1fa2"

  io_registry: "IORegistry" {
    class: io
    tooltip: |md
      Central routing table for all IO endpoints.
      Maps endpoint names → (controller, signal_type, channel).
      Configured from io_endpoints.yaml + machine_config.yaml.
    |
  }

  bound_ep: "BoundEndpoint" {
    class: io
    tooltip: "Resolved endpoint: controller + channel.\nCalls set_digital / set_analog / send_trigger."
  }

  mcu_io: "MCUIOController" {
    class: io
    tooltip: |md
      Routes to Teensy microcontroller.
      Channels: port:N (illumination), pin:N (TTL),
      trigger:N (camera), dac:N (analog out).
    |
  }

  nidaq_io: "NIDAQIOController" {
    class: io
    tooltip: |md
      Routes to NI-DAQ hardware.
      AO channels for analog intensity,
      DO channels for TTL shutters.
    |
  }

  serial_io: "SerialIOController" {
    class: io
    tooltip: "Routes to serial light sources\n(CoolLED, LDI, Andor, etc.)"
  }

  io_registry -> bound_ep: "resolve endpoint"
  bound_ep -> mcu_io
  bound_ep -> nidaq_io
  bound_ep -> serial_io
}

# ============================================================================
# ILLUMINATION DEVICES
# ============================================================================
illum_devices: "Illumination Devices" {
  style.fill: "#fce4ec"
  style.stroke: "#c62828"

  io_routed: "IORoutedIlluminationDevice\nindividual laser/LED channels\nvia DAC (intensity) + TTL (shutter)" {
    class: hw
  }
  serial_illum: "SerialIlluminationDevice\nCoolLED pE-400, Lumencor LDI/CELESTA,\nAndor Laser, VersaLase" {
    class: hw
  }
  led_matrix: "LEDMatrixIlluminationDevice\nMCU-driven LED array or\nSciMicroscopy RGB array\n(BF, DF, DPC patterns)" {
    class: hw
  }
}

# ============================================================================
# HARDWARE COMPONENTS
# ============================================================================
hardware: "Physical Hardware" {
  style.fill: "#fce4ec"
  style.stroke: "#c62828"

  mcu: "Teensy Microcontroller\n(USB Serial, CRC8 protocol)" {
    class: hw
    tooltip: |md
      Central hardware coordinator.
      - Drives stepper motors (X/Y/Z/Theta/W)
      - 8-channel DAC for analog outputs
      - 16 illumination ports (multi-port firmware)
      - TTL outputs for shutters & triggers
      - Hardware trigger with illumination sync
      - Status packets every ~10ms
    |
  }

  stage: "Motorized Stage\n(X, Y, Z, Theta axes)" {
    class: hw
    tooltip: |md
      Stepper motors with configurable microstepping.
      Typical: 200 full-steps/rev, 2.54mm screw pitch.
      Limit switches for homing.
      Max ~30 mm/s, 500 mm/s² acceleration.
    |
  }

  main_camera: "Main Camera" {
    class: hw
    tooltip: |md
      Acquisition camera. Supported SDKs:
      Daheng (GXiPy), Hamamatsu (DCAM), Tucsen,
      Andor (SDK3), IDS (Peak), FLIR, Photometrics.
      Trigger modes: software, hardware (LINE2), continuous.
      Pixel formats: MONO8/12/16, Bayer.
    |
  }

  focus_camera: "Focus Camera\n(Laser AF sensor)" {
    class: hw
    tooltip: |md
      Detects reflected laser spot position.
      Spot centroid shift → Z displacement.
      Separate from main camera.
    |
  }

  piezo: "Objective Piezo\n(Fine Z, 0–300 μm)" {
    class: hw
    tooltip: |md
      Sub-micron Z positioning for the objective.
      Controlled via DAC voltage (0–10V).
      Used for fast Z-stacking and focus tracking.
    |
  }

  filter_wheel: "Emission Filter Wheel" {
    class: hw
    tooltip: "Multi-position wheel with bandpass filters.\nSelects emission wavelength for fluorescence."
  }

  spinning_disk: "Spinning Disk Confocal\n(XLight / Dragonfly)" {
    class: hw
    tooltip: |md
      Optical sectioning via spinning pinhole disk.
      Controls: disk motor, dichroic wheel,
      emission/excitation filters, iris diaphragm.
    |
  }

  laser_combiner: "Laser Combiner\n(NL5 / CellX)" {
    class: hw
    tooltip: "Combines multiple laser lines\ninto a single fiber output.\nTTL-gated per line."
  }

  nidaq_hw: "NI-DAQ Card" {
    class: hw
    tooltip: |md
      National Instruments data acquisition.
      AO: analog waveforms (100kHz sample rate).
      DO: digital TTL outputs.
      Used for high-speed synchronized illumination.
    |
  }

  led_array: "LED Matrix /\nSciMicroscopy Array" {
    class: hw
    tooltip: |md
      Programmable LED illumination patterns.
      Modes: brightfield, darkfield, DPC (phase contrast).
      RGB color mixing for multi-wavelength.
    |
  }

  obj_changer: "Objective Changer\n(Xeryon 2-position turret)" {
    class: hw
    tooltip: |md
      Switches between 2 objectives.
      Automatic Z-compensation on switch.
      Xeryon piezo motor, serial control.
    |
  }

  fluidics: "Fluidics System" {
    class: hw
    tooltip: "Automated sample handling,\nmedia exchange, reagent delivery."
  }

  # Internal hardware connections
  mcu -> stage: "stepper\npulses"
  mcu -> piezo: "DAC voltage\n(dac:7)"
  mcu -> led_array: "port intensity\n+ TTL patterns"
}

# ============================================================================
# DATA MODELS (Pydantic)
# ============================================================================
models: "Data Models (Pydantic)" {
  style.fill: "#fff9c4"
  style.stroke: "#f9a825"

  obs_state: "ObservationState\n(v3)" {
    class: model
    tooltip: |md
      Complete light-path configuration for one acquisition step.
      Analogous to a 'channel' in microscopy software.
      - camera_settings: CameraSettings (exposure, gain, pixel_format)
      - illuminator_states: List[IlluminatorState] (per-source intensity, on/off)
      - emission_filter_positions, z_offset_um
      - confocal_hardware_settings: ConfocalSettings (iris)
      - camera_live: CameraLiveSnapshot (ROI, binning, trigger)
      - display_color, channel_groups
    |
  }

  illuminator_state: "IlluminatorState" {
    class: model
    tooltip: |md
      Runtime state of one illumination source:
      - illumination_channel (name → IlluminationChannel)
      - intensity (0–100%)
      - on (bool)
      - led_matrix_mode (optional)
    |
  }

  acq_metadata: "AcquisitionMetadata" {
    class: model
    tooltip: |md
      Per-run reproducibility record:
      - experiment_id, objective, pixel_size
      - selected observation state names
      - observation_state snapshot
      - Written to acquisition.yaml
    |
  }

  illum_channel: "IlluminationChannel" {
    class: model
    tooltip: |md
      Hardware illumination definition (machine config):
      - type: EPI or TRANSILLUMINATION
      - controller_port (D1-D8, USB1-USB8)
      - wavelength_nm
      - excitation filter wheel + position
    |
  }

  hw_bindings: "HardwareBindingsConfig" {
    class: model
    tooltip: |md
      Maps cameras to filter wheels
      and dichroic positions.
      Source-qualified references
      (confocal.1, standalone.Emission).
    |
  }

  camera_live: "CameraLiveSnapshot" {
    class: model
    tooltip: "Runtime camera state:\nexposure, gain, ROI, binning,\ntrigger mode, FPS"
  }

  channel_group: "ChannelGroup" {
    class: model
    tooltip: "Multi-camera synchronization:\nSIMULTANEOUS or SEQUENTIAL\nwith per-channel timing offsets"
  }

  obs_state -> illuminator_state: "contains"
  obs_state -> camera_live: "snapshots"
  obs_state -> channel_group: "groups"
  illuminator_state -> illum_channel: "references by name"
  acq_metadata -> obs_state: "embeds"
}

# ============================================================================
# CONFIGURATION LAYER
# ============================================================================
config: "Configuration (YAML)" {
  style.fill: "#efebe9"
  style.stroke: "#4e342e"

  config_repo: "ConfigRepository" {
    class: storage
    tooltip: |md
      Loads and caches all YAML configuration.
      Manages user profiles and per-objective overrides.
      Merges general + objective channel configs at runtime.
    |
  }

  machine_config: "machine_configs/library/\n(selected machine config)" {
    class: storage
    tooltip: |md
      Top-level hardware definition:
      devices (teensy, camera, stage, piezo, laser_af, nidaq),
      illumination_devices, objectives,
      IO endpoints, hardware bindings.

      Active config is picked from machine_configs/library/
      via the startup dialog and remembered globally in
      cache/last_machine_config.txt.
    |
  }

  general_yaml: "general.yaml\n(channel identity)" {
    class: storage
    tooltip: "Channel name, color, illumination_channel,\nfilter_wheel, z_offset, camera ID.\nShared across all objectives."
  }

  objective_yaml: "{objective}.yaml\n(per-objective overrides)" {
    class: storage
    tooltip: "Intensity, exposure, gain, pixel_format,\nconfocal_override per channel.\nMerged with general.yaml at runtime."
  }

  preset_yaml: "observation_presets/\n{name}.yaml" {
    class: storage
    tooltip: "Saved ObservationState snapshots.\nUser can save/load presets\nfrom the GUI."
  }

  cycle_yaml: "cycles/\n{name}.yaml" {
    class: storage
    tooltip: "Saved AcquisitionCycle definitions.\nTwo-level: outer repeat → ordered steps\n(state + frame count), waits (delays), and\none-level groups. Waits allowed at any level.\nReference observation states by name.\nEdited via the multipoint 'Edit Cycles' dialog."
  }

  gui_state_yaml: "{profile}/gui_state.yaml" {
    class: storage
    tooltip: |md
      Per-profile transient UI state, persisted on shutdown:
      - Window geometry / dock state
      - Selected record tab index
      - Last active objective + observation state name
      - Snap saving directory + tag
      - Live display FPS, autolevel, resolution scaling
      Restored on the next launch.
    |
  }

  illum_yaml: "illumination_channel_config.yaml" {
    class: storage
    tooltip: "Hardware illumination definitions:\nchannel names, ports, wavelengths,\nfilter wheel associations."
  }

  io_yaml: "io_endpoints.yaml" {
    class: storage
    tooltip: "IO endpoint definitions:\ntrigger, intensity, shutter channels\nmapped to controllers + pins."
  }

  sample_formats_yaml: "sample_formats.yaml" {
    class: storage
    tooltip: |md
      Plate-intrinsic geometry for each wellplate / sample holder:
      plate_dimensions_mm, a1_offset_mm (from plate corner),
      row/col spacing, well shape (circle or rectangle) + dims,
      chamfer / plate corner radius. Machine-independent —
      stage calibration lives in machine_config.yaml.
    |
  }

  plate_image_gen: "wellplate_image_generator" {
    class: controller
    tooltip: |md
      Auto-generates PNG background maps for the plate viewer
      from sample_formats.yaml. Renders circular or rectangular
      wells, arbitrary grids, plate corner radius, A1 chamfer.
      Outputs cached under cache/plate_images/ with mtime check.
    |
  }

  config_repo -> machine_config: reads
  config_repo -> general_yaml: reads/writes
  config_repo -> objective_yaml: reads/writes
  config_repo -> preset_yaml: reads/writes
  config_repo -> gui_state_yaml: reads/writes
  config_repo -> illum_yaml: reads
  config_repo -> io_yaml: reads
  plate_image_gen -> sample_formats_yaml: reads
}

# ============================================================================
# DATA OUTPUT / WRITERS
# ============================================================================
writers: "Data Output" {
  style.fill: "#efebe9"
  style.stroke: "#4e342e"

  mp_worker: "MultiPointWorker\n(Job Queue)" {
    class: controller
    tooltip: |md
      Queue-based async job processing.
      Iterates each region's resolved cycle plan:
      per imaged event computes a self-describing
      SaveLayout (array key + T/C coords + sizes)
      so the save layer needs no global uniform
      (T,C,Z) assumption.
      Job types: SaveImage, SaveOMETiff,
      SaveZarr, DownsampledView, Postprocess.
    |
  }

  postprocess: "PostprocessJob\n(online routines)" {
    class: storage
    tooltip: |md
      Optional online postprocessing (Advanced cycles).
      Accumulates a step/group's frames per FOV in a
      dedicated runner, runs a routine (built-in phase2d
      / dpc2d, or a custom script), and writes the outputs as
      their own {label}_{output} plates via inline
      SaveZarrJob / TIFF — raw inputs are NOT saved.
      TF cache persists across FOVs. ZARR_V3 +
      INDIVIDUAL_IMAGES only. See online-postprocessing.md.
    |
  }

  fast_writer: "FastAcquisitionWriter\n(Thread)" {
    class: controller
    tooltip: |md
      High-speed streaming:
      1. Write raw bytes → frames.raw
      2. Per-frame metadata → frame_metadata.jsonl
      3. Post-capture decode → final format
    |
  }

  zarr_writer: "Zarr v3 Writer\n(TensorStore)" {
    class: storage
    tooltip: |md
      OME-NGFF v0.5 per-FOV output.
      5D shape (T, C, Z, Y, X).
      Cycle layouts (decided per region):
      - Dense (equal frames/channel): one plate,
        frames fold into T (T = Nt × frames/state).
      - Ragged (unequal frames/channel): one
        single-channel plate per state, each with
        its own T size; manifest joins them.
      Streaming multiscale pyramid.
      frame_times zarr array for timestamps.
      HCS plate hierarchy for wellplate scans AND
      (via hcs_map) flexible scans.
    |
  }

  hcs_map: "HCS Region Mapping" {
    class: model
    tooltip: |md
      control/core/hcs_region_mapping.py
      Single source of the plate-layout decision.
      Maps arbitrary flexible region names onto
      synthetic NGFF plate cells (row/col must be
      ^[A-Za-z0-9]+$, so names can't be wells).
      Region names survive as _squid annotations on
      the plate root / well / FOV groups.
      Used by MultiPointWorker (where data lands),
      the NDViewer path builder (live view), and
      mirrored in tools/flexible_to_hcs_zarr.py for
      offline conversion of older datasets.
    |
  }

  ome_tiff: "OME-TIFF Writer" {
    class: storage
    tooltip: |md
      OME-TIFF stacks.
      Axes: TZCYX.
      Per-plane metadata.
      Compatible with ImageJ/FIJI.
    |
  }

  acq_yaml: "acquisition.yaml" {
    class: storage
    tooltip: |md
      Per-experiment metadata file:
      - manifest (experiment_id, objective, pixel size)
      - scan_parameters (grid, z-stack, time-lapse)
      - observation_states_used (full preset snapshots)
    |
  }

  mp_worker -> zarr_writer: "SaveZarrJob"
  mp_worker -> hcs_map: "region -> well\n(resolved at acq start)"
  hcs_map -> zarr_writer: "plate layout + region annotations"
  mp_worker -> ome_tiff: "SaveOMETiffJob"
  mp_worker -> postprocess: "PostprocessJob\n(postprocessed frames)"
  postprocess -> zarr_writer: "derived output plates"
}

# ============================================================================
# CONNECTIONS — Startup Flow
# ============================================================================
main_hcs -> controllers.microscope: "1. build_from_global_config()" {
  style.stroke: "#1565c0"
  style.stroke-width: 2
}
main_hcs -> gui.main_window: "2. HighContentScreeningGui(microscope)" {
  style.stroke: "#2e7d32"
  style.stroke-width: 2
}

# ============================================================================
# CONNECTIONS — GUI ↔ Controllers
# ============================================================================
gui.main_window -> controllers.microscope: "references"
gui.main_window -> controllers.mp_ctrl: "owns"
gui.main_window -> controllers.af_ctrl: "owns"
gui.main_window -> controllers.laser_af_ctrl: "owns"
gui.main_window -> controllers.movement_updater: "owns"

gui.live_widgets.live_control -> controllers.live_ctrl: "start/stop\nlive acquisition" {
  class: signal_style
}
gui.live_widgets.illumination -> controllers.illum_ctrl: "set_intensity\nturn_on/off" {
  class: signal_style
}
gui.live_widgets.camera_settings -> hardware.main_camera: "exposure, gain,\nROI, binning" {
  class: signal_style
}
gui.live_widgets.obs_state -> config.preset_yaml: "save/load\npresets" {
  class: signal_style
}
gui.hardware_widgets.navigation -> hardware.stage: "jog XYZ" {
  class: signal_style
}
gui.acquisition_widgets.flex_mp -> controllers.mp_ctrl: "configure &\nstart acquisition" {
  class: signal_style
}
gui.acquisition_widgets.wellplate_mp -> controllers.mp_ctrl: "well-based\nacquisition" {
  class: signal_style
}
gui.viewers.plate_view -> config.plate_image_gen: "ensure_plate_image()" {
  class: signal_style
}

# ============================================================================
# CONNECTIONS — Controllers ↔ Hardware
# ============================================================================
controllers.microscope -> config.config_repo: "loads config"
gui.hardware_widgets.profile_startup -> config.config_repo: "lists/creates\nprofiles at startup"
controllers.microscope -> io_layer.io_registry: "owns"
controllers.live_ctrl -> controllers.stream_handler: "registers\ncallback"

controllers.illum_ctrl -> illum_devices.io_routed: "manages"
controllers.illum_ctrl -> illum_devices.serial_illum: "manages"
controllers.illum_ctrl -> illum_devices.led_matrix: "manages"

illum_devices.io_routed -> io_layer.io_registry: "set_analog\nset_digital"
illum_devices.serial_illum -> io_layer.serial_io: "serial protocol"
illum_devices.led_matrix -> hardware.mcu: "multi-port API"

io_layer.mcu_io -> hardware.mcu: "USB Serial\nbinary packets"
io_layer.nidaq_io -> hardware.nidaq_hw: "NI-DAQmx API"

controllers.live_ctrl -> hardware.main_camera: "trigger +\nacquire frames"
controllers.laser_af_ctrl -> hardware.focus_camera: "acquire spot\nimages"
controllers.laser_af_ctrl -> hardware.piezo: "fine Z\ncorrection"
controllers.af_ctrl -> hardware.stage: "Z sweep"
controllers.af_ctrl -> hardware.main_camera: "sharpness\nmeasurement"

controllers.mp_ctrl -> controllers.live_ctrl: "set_channel\ntrigger acquire"
controllers.mp_ctrl -> controllers.af_ctrl: "autofocus\nbefore each FOV"
controllers.mp_ctrl -> controllers.laser_af_ctrl: "laser AF\nbefore each FOV"
controllers.mp_ctrl -> hardware.stage: "move to\nnext position"
controllers.mp_ctrl -> writers.mp_worker: "enqueue\nsave jobs"

# ============================================================================
# CONNECTIONS — Frame Data Flow
# ============================================================================
hardware.main_camera -> controllers.stream_handler: "CameraFrame\n(async callback)" {
  style.stroke: "#d32f2f"
  style.stroke-width: 2
}
controllers.stream_handler -> gui.viewers.napari: "image_to_display\n(rate-limited)" {
  style.stroke: "#d32f2f"
  style.stroke-width: 2
}
controllers.stream_handler -> writers.mp_worker: "packet_image_to_write\n(frame + metadata)" {
  style.stroke: "#d32f2f"
  style.stroke-width: 2
}
controllers.stream_handler -> writers.fast_writer: "raw bytes\n(high-speed mode)" {
  style.stroke: "#d32f2f"
  style.stroke-width: 2
}

# ============================================================================
# CONNECTIONS — Metadata Flow
# ============================================================================
controllers.mp_ctrl -> writers.acq_yaml: "build_acquisition_metadata\n+ observation_states_used"
config.config_repo -> models.obs_state: "load/save presets\n+ merge configs"
config.config_repo -> models.illum_channel: "loads hw definitions"

# ============================================================================
# CONNECTIONS — Hardware Trigger Synchronization
# ============================================================================
hardware.mcu -> hardware.main_camera: "hardware trigger\n(LINE2 GPIO)" {
  style.stroke: "#c62828"
  style.stroke-width: 2
  style.stroke-dash: 0
}

# ============================================================================
# LEGEND
# ============================================================================
legend: "Legend" {
  style.fill: "#fafafa"
  style.stroke: "#bdbdbd"
  style.border-radius: 12

  hw_ex: "Hardware Component" { class: hw }
  ctrl_ex: "Controller / Service" { class: controller }
  model_ex: "Data Model (Pydantic)" { class: model }
  gui_ex: "GUI Widget (PyQt5)" { class: gui }
  io_ex: "IO Abstraction" { class: io }
  storage_ex: "Config / Storage" { class: storage }

  red_line: "Frame data flow" {
    style.fill: transparent
    style.stroke: "#d32f2f"
    style.stroke-width: 2
  }
  orange_line: "Qt signal / user action" {
    style.fill: transparent
    style.stroke: "#ff6f00"
    style.stroke-dash: 4
  }
}
