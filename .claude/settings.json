{
  "permissions": {
    "allow": [
      "Grep",
      "Glob",
      "LS",
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "Bash(conda activate *)",
      "Bash(pixi *)",
      "Bash(python *)",
      "Bash(pytest *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(rm -rf *)",
      "Bash(del /f /s /q *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git commit*)"
    ]
  }
}